<!-- security/hms_security.xml -->
<odoo>
    <record id="module_category_hms" model="ir.module.category">
        <field name="name">Hospital Management</field>
    </record>

    <record id="hms_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_hms"/>
    </record>

    <record id="hms_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hms"/>
        <field name="implied_ids" eval="[(4, ref('hms_group_user'))]"/>
    </record>
    <!-- de el rulee eli bahotha la el salary msln-->

<record id="hms_patient_rule_user" model="ir.rule">
    <field name="name">Patient: user sees only own records</field>
    <field name="model_id" ref="model_hms_patient"/>
    <field name="domain_force">[('create_uid', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('hms_group_user'))]"/>
</record>
    <record id="hms_patient_rule_manager" model="ir.rule">
    <field name="name">Patient: manager sees all records</field>
    <field name="model_id" ref="model_hms_patient"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('hms_group_manager'))]"/>
</record>
</odoo>