<odoo>
<record id="patients_list" model="ir.ui.view">
    <field name="name">hms.patient.list</field>
    <field name="model">hms.patient</field>
    <field name="arch" type="xml">

        <list>

            <field name="first_name"/>
            <!--<field name="age"/>
            <field name="address"/>
            <field name="last_name"/>
            <field name="birth_date"/>
            <field name="blood_type"/>
            <field name="history"/>
            <field name="cr_ratio"/>
            <field name="pcr"/>
            <field name="image"/> -->
        </list>
    </field>
</record>
    <record id="patient_form" model="ir.ui.view">
    <field name="name">hms.patient.form</field>
    <field name="model">hms.patient</field>
    <field name="arch" type="xml">

        <form>
            <header>
                <button name="move_to_good" type="object" string="Good"/>
                <button name="move_to_fair" type="object" string="Fair"/>
                <button name="move_to_serious" type="object" string="Serious"/>
                <field name="state" widget="statusbar" statusbar_visible="undetermined,good,fair,serious"/>
            </header>
            <group>
                <group>
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="age"/>
                    <field name="address"/>
                    <field name="birth_date"/>
                </group>
                <group>
                    <field name="image" widget="image"/>
                </group>

            </group>
             <group>
                <field name="department_id"/>
                <field name="department_capacity"/>
                <field name="doctor_id" widget="many2many_tags"
                       domain="[('department_id', '=', department_id)]"
                       readonly="not department_id"
                       groups="hms.hms_group_manager"/>
            </group>
            <notebook>
                <page string=" Medical information">
                    <group>
                        <field name="blood_type"/>
                        <field name="pcr"/>
                        <field name="cr_ratio" required="pcr"/>
                        <field name="history" invisible="age &lt; 50"/>
                    </group>

                </page>

                 <page string="Log History">
                    <field name="log_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="created_by"/>
                            <field name="description"/>
                        </list>
                    </field>
                </page>
            </notebook>

        </form>
    </field>
</record>
      <record id="action_hms_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hms_root" name=" Hospital Management"/>
    <menuitem id="hms_patient" name=" Patients" parent="hms_root" action="action_hms_patient"/>

</odoo>