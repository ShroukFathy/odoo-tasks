<odoo>
    <record id="doctors_list" model="ir.ui.view">
        <field name="name">hms.doctors.list</field>
        <field name="model">hms.doctors</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department_id"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>
    <record id="doctors_form" model="ir.ui.view">
        <field name="name">hms.doctors.form</field>
        <field name="model">hms.doctors</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="gender"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="license_number"/>
                    <field name="date_of_birth"/>
                </group>
            </form>
        </field>
    </record>
    <record id="hms_doctors_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hms.doctors</field>
        <field name="view_mode">list,form</field>
    </record>
<menuitem id="hms_doctors" name="Doctors" parent="hms_root" action="hms_doctors_action" groups="hms.hms_group_manager"/>
</odoo>