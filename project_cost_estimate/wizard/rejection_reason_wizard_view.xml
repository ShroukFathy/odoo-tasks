<odoo>
    <record id="rejection_reason_wizard_form" model="ir.ui.view">
        <field name="name">rejection reason wizard form </field>
        <field name="model">rejection.reason</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="estimate_id" invisible="1"/>
                    <field name="reason" placeholder="What's the reason of rejection?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rejection_reason_wizard" model="ir.actions.act_window">
    <field name="name">Reject Cost Estimate</field>
    <field name="res_model">rejection.reason</field>
    <field name="target">new</field>
    <field name="view_mode">form</field>
    </record>
    <menuitem id="cost_estimate_history_menu" name="History" parent="project_cost_root">

    </menuitem>
</odoo>