<odoo>
    <record id="cost_estimate_history_list_view" model="ir.ui.view">
        <field name="name">project.cost.estimate.history.list</field>
        <field name="model">project.cost.estimate.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="estimate_id"/>
                <field name="old_state"/>
                <field name="new_state"/>
                <field name="reason"/>
                <field name="user_id"/>
                <field name="create_date" string="Changed On"/>
            </list>
        </field>
    </record>

    <record id="cost_estimate_history_form_view" model="ir.ui.view">
        <field name="name">project.cost.estimate.history.form</field>
        <field name="model">project.cost.estimate.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="estimate_id" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="old_state" readonly="1"/>
                        <field name="new_state" readonly="1"/>
                        <field name="reason" readonly="1"/>
                        <field name="create_date" readonly="1" string="Changed On"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cost_estimate_history" model="ir.actions.act_window">
        <field name="name">Cost Estimate History</field>
        <field name="res_model">project.cost.estimate.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cost_estimate_history" name="Estimate History"
              parent="project.menu_main_pm" action="action_cost_estimate_history"
              groups="project_cost_estimate.group_project_cost_user"/>
</odoo>