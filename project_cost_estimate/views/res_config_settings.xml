<odoo>
    <record id="res_config_settings_project_inherit" model="ir.ui.view">
        <field name="name">project.res_config_settings_project_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='tasks_management']" position="inside">
                <setting id="cost_estimate_seq" help="Set a prefix value">
                    <field name="cost_estimate_seq"/>
                </setting>
            </xpath>

        </field>

    </record>
</odoo>