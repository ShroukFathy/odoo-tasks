<odoo>
    <record id="project_cost_estimate_form_view" model="ir.ui.view">
    <field name="name">project.cost.estimate.form</field>
    <field name="model">project.cost.estimate</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="action_submit" type="object" string="Submit"
                        invisible="state != 'draft'"
                        groups="project_cost_estimate.group_project_cost_admin,project_cost_estimate.group_project_super_admin"/>
                <button name="action_approve" type="object" string="Approve"
                        invisible="state != 'submitted'"
                        groups="project_cost_estimate.group_project_super_admin"/>
                <button name="action_reject" type="object" string="Reject"
                        invisible="state != 'submitted'"
                        groups="project_cost_estimate.group_project_super_admin"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <field name="name" readonly="state != 'draft'"/>
                    <field name="project_id" readonly="state != 'draft'"/>
                    <field name="estimated_total_cost"/>
                </group>
                <notebook>
                    <page string="Cost Breakdown">
                        <field name="breakdown_ids" readonly="state != 'draft'">
                            <list editable="bottom">
<!--                            <field name="name"/>-->
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="unit_cost"/>
                                <field name="subtotal" sum="Total"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
    </record>
    <record id="cost_estimate_kanban" model="ir.ui.view">
    <field name="name">cost.estimate.kanban</field>
    <field name="model">project.cost.estimate</field>
    <field name="arch" type="xml">
        <kanban>
            <templates>
                <t t-name="kanban-box">
                 <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="oe_kanban_content">
                            <strong><field name="name"/></strong>
                            <div>Project: <field name="project_id"/></div>
                            <div>Total: <field name="estimated_total_cost"/></div>
                        </div>
                 </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>
