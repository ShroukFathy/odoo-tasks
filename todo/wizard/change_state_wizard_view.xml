<odoo>
    <record id="change_state_wizard_form" model="ir.ui.view">
        <field name="name">change state wizard form </field>
        <field name="model">change.state</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="state"/>
                    <field name="reason" placeholder="Why are you changing state?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="todo_change_state_server_action" model="ir.actions.server">
        <field name="name">Change state</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="state">code</field>
        <field name="code">
            action= records.action_open_change_state_wizard()
        </field>

    </record>
    <record id="action_change_state_wizard" model="ir.actions.act_window">
        <field name="name">Change State</field>
        <field name="res_model">change.state</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>


    </record>
</odoo>