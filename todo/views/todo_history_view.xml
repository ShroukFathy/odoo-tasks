<odoo>
    <record id="todo_history_list_view" model="ir.ui.view">
        <field name="name">todo.history.list</field>
        <field name="model">todo.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="user_id"/>
                <field name="task_id"/>
                <field name="old_state"/>
                <field name="new_state"/>

            </list>
        </field>
    </record>
    <record id="todo_history_form_view" model="ir.ui.view">
        <field name="name">todo.history.form</field>
        <field name="model">todo.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="task_id"/>
                    </group>
                     <group>
                        <field name="old_state"/>
                        <field name="new_state"/>
                         <field name="reason"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <record id="action_todo_history" model="ir.actions.act_window">
        <field name="name">History</field>
        <field name="res_model">todo.history</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="todo_history_root" name="TO-DO history"/>
    <menuitem id="todo_history_menu" name="Task history" parent="todo_history_root" action="action_todo_history"/>
</odoo>