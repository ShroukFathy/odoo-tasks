<odoo>
    <record id="todo_list_view" model="ir.ui.view">
        <field name="name">todo.task.list</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_late">
                <field name="task_name"/>
                <field name="assign_to" optional="hide"/>
                <field name="due_date" />
                <field name="is_late" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="todo_form_view" model="ir.ui.view">
        <field name="name">todo.task.form</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" options="{'clickable' :1 }"/>
                    <button name="action_new" string="New" type="object"
                            class="btn_primary"
                            invisible="status != 'new' "/>
                    <button name="action_inprogress" type="object" string="In progress"
                            class="btn_secondary"
                            invisible="status !='in_progress'"/>
                    <button name="action_completed" type="object" string="In progress"
                            class="btn_secondary"
                            invisible="status !='completed'"/>
                    <button name="action_closed" type="object" string="In progress"
                            class="btn_secondary"
                            invisible="status !='in_closed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="ref"/>
                        <h1>
                            <field name="ref"/>
                        </h1>
                         <label for="task_name"/>
                        <h3>
                            <field name="task_name"/>
                        </h3>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="assign_to"/>
                        <field name="description"/>
                        <field name="due_date"/>
                        <field name="estimated_time"/>
                        <field name="timesheet_ids">
                            <list editable="bottom">
                                <field name="description"/>
                                <field name="date"/>
                                <field name="user_id"/>
                                <field name="hours_spent" sum="Total"/>
                            </list>
                        </field>



                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="todo_search_view" model="ir.ui.view">
    <field name="name">todo.task.search</field>
    <field name="model">todo.task</field>
    <field name="arch" type="xml">
        <search>
            <field name="task_name"/>
            <field name="assign_to"/>
            <filter name="filter_new" string="New" domain="[('status', '=', 'new')]"/>
            <filter name="filter_in_progress" string="In Progress" domain="[('status', '=', 'in_progress')]"/>
            <filter name="filter_completed" string="Completed" domain="[('status', '=', 'completed')]"/>

        </search>
    </field>
</record>
    <record id="action_all_tasks" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_closed" model="ir.actions.server">
        <field name="name">Closed</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_closed()
        </field>
    </record>
    <record id="cron_check_late_tasks" model="ir.cron">
    <field name="name">Todo: Check Late Tasks</field>
    <field name="model_id" ref="model_todo_task"/>
    <field name="state">code</field>
    <field name="code">model.cron_check_late_tasks()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
    </record>
    <menuitem id="todo_root" name="TO-DO"/>
    <menuitem id="all_tasks" name="All tasks" parent="todo_root" action="action_all_tasks"/>
</odoo>