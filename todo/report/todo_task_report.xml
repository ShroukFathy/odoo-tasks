<odoo>
    <record id="action_report_todo_task" model="ir.actions.report">
    <field name="name">Task Report</field>
    <field name="model">todo.task</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">todo.report_todo_task_document</field>
    <field name="report_file">todo.report_todo_task_document</field>
    <field name="binding_model_id" ref="model_todo_task"/>
    <field name="binding_type">report</field>
</record>

<template id="report_todo_task_document">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 t-esc="doc.task_name"/>
                    <p><strong>Status:</strong> <span t-esc="doc.status"/></p>
                    <p><strong>Assigned To:</strong> <span t-esc="doc.assign_to.name"/></p>
                    <p><strong>Due Date:</strong> <span t-esc="doc.due_date"/></p>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>